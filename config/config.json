{
  "config_version": 1,

  "mqtt": { "host": "localhost", "port": 1883, "base_topic": "pond1" },

  "sampling": { "period_s": 5, "tds_settle_s": 2 },

  "sensors": [
    {
      "id": "temp",
      "label": "Nhiệt độ",
      "unit": "°C",
      "enabled": true,
      "valid_range": [0, 50],
      "warn_range": [24, 36]
    },
    {
      "id": "ph",
      "label": "pH",
      "unit": "",
      "enabled": true,
      "valid_range": [0, 14],
      "warn_range": [7.0, 8.5]
    },
    {
      "id": "tds",
      "label": "TDS",
      "unit": "ppm",
      "enabled": false,
      "valid_range": [0, 5000],
      "warn_range": [0, 800]
    }
  ],

  "do_model": {
    "aerator_on_below": 3.0,
    "aerator_off_above": 5.5,
    "aerator_k_per_s": 0.04,
    "uptake_ref_mg_per_l_per_s": 0.024,
    "uptake_ref_temp_c": 25,
    "uptake_q10": 2.0
  },

  "pump": {
    "cool_on_above_c": 31,
    "cool_off_below_c": 30.5,
    "burst_s": 10,
    "wait_s": 10,
    "max_s_per_hour": 60,
    "renew_s": 15
  },

  "control": { "manual_pause_s": 300, "esp32_offline_failsafe_s": 60 },

  "telegram": { "cooldown_s": 600 },

  "pond_geometry_m": {
    "length": 0.6,
    "width": 0.4,
    "height": 0.3,
    "water_level_fixed_m": null
  }
}
